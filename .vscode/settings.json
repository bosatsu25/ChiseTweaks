{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.gradle.enabled": true,
  "java.import.gradle.wrapper.enabled": true,
  "java.test.config": [
    {
      "name": "ChiseTweaks tests",
      "workingDirectory": "${workspaceFolder}"
    }
  ],
  "files.exclude": {
    "**/.gradle": true,
    "**/build": true,
    "**/run": true,
    "**/runs": true
  },
  "search.exclude": {
    "**/.gradle": true,
    "**/build": true,
    "**/run": true,
    "**/runs": true
  }
}
