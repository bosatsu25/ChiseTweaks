{
  "schemaVersion": 1,
  "id": "chisetweaks",
  "version": "${version}",
  "name": "ChiseTweaks",
  "description": "Standalone client-only building assistance and visual inspection tools for large Minecraft builds and technical facilities.",
  "license": [
    "MIT",
    "Apache-2.0"
  ],
  "authors": [
    "ChiseTweaks contributors"
  ],
  "icon": "assets/chisetweaks/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.chise.chisetweaks.ChiseTweaksClient"
    ]
  },
  "mixins": [
    "chisetweaks.features.mixins.json",
    "chisetweaks.sodium.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "java": ">=25"
  },
  "recommends": {
    "sodium": ">=${sodium_compat_version}"
  },
  "custom": {
    "chisetweaks": {
      "side": "client-only",
      "serverInstallationRequired": false,
      "customPlayProtocol": false,
      "serverProtocolOwnership": "none",
      "remoteModDetection": false,
      "backgroundThreads": false,
      "automaticModDownload": false,
      "automaticJarReplacement": false,
      "featureFailureMode": "quarantine",
      "mixinFailureMode": "fail-soft",
      "settingsOwnership": "standalone",
      "externalConfigLibraryRequired": false,
      "modMenuRequired": false
    }
  }
}
