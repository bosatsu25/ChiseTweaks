{
  "schemaVersion": 1,
  "id": "chisetweaks",
  "version": "${version}",
  "name": "ChiseTweaks",
  "description": "Client-only building assistance and visual inspection tools for large Minecraft builds and technical facilities.",
  "license": [
    "MIT",
    "Apache-2.0"
  ],
  "authors": [
    "ChiseTweaks contributors"
  ],
  "icon": "assets/chisetweaks/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.chise.chisetweaks.ChiseTweaks"
    ],
    "client": [
      "dev.chise.chisetweaks.ChiseTweaksClient"
    ],
    "modmenu": [
      "dev.chise.chisetweaks.compat.ChiseTweaksModMenu"
    ]
  },
  "mixins": [
    "chisetweaks.features.mixins.json",
    "chisetweaks.sodium.mixins.json"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "java": ">=25",
    "malilib": ">=${malilib_version}"
  },
  "recommends": {
    "modmenu": ">=${modmenu_version}",
    "sodium": ">=${sodium_compat_version}"
  },
  "custom": {
    "chisetweaks": {
      "side": "client-only",
      "serverInstallationRequired": false,
      "customPlayProtocol": false,
      "serverProtocolOwnership": "none",
      "remoteModDetection": false,
      "backgroundThreads": false,
      "automaticModDownload": false,
      "automaticJarReplacement": false,
      "featureFailureMode": "quarantine",
      "mixinFailureMode": "fail-soft"
    }
  }
}
